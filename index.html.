
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#100e17">
<meta name="description" content="Light AI - Think, Learn, Create">
<link rel="manifest" href="manifest.json">
<title>Light AI</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #100e17;
  color: #f5f2fa;
  font-family: system-ui, sans-serif;
  height: 100dvh;
  display: flex;
  flex-direction: column;
}

header {
  min-height: 75px;
  display: flex;
  align-items: center;
  padding: 10px 18px;
  border-bottom: 1px solid #292432;
}

header img {
  width: 175px;
  max-width: 65vw;
  height: auto;
}

main {
  flex: 1;
  overflow-y: auto;
  padding: 20px 16px;
  width: 100%;
  max-width: 760px;
  margin: auto;
}

.welcome {
  text-align: center;
  margin: 12vh auto 30px;
}

.welcome img {
  width: 110px;
  height: 110px;
  margin-bottom: 15px;
}

.welcome h1 {
  font-size: 27px;
  margin-bottom: 8px;
}

.welcome p {
  color: #aaa2b8;
}

.message {
  padding: 13px 16px;
  border-radius: 17px;
  margin: 12px 0;
  max-width: 88%;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.user {
  background: #7650bd;
  margin-left: auto;
}

.assistant {
  background: #211d2b;
  border: 1px solid #302a3c;
}

.composer {
  padding: 12px 14px max(14px, env(safe-area-inset-bottom));
  border-top: 1px solid #292432;
  background: #100e17;
}

form {
  max-width: 760px;
  margin: auto;
  display: flex;
  gap: 9px;
  background: #211d2b;
  border: 1px solid #383044;
  border-radius: 20px;
  padding: 7px;
}

textarea {
  flex: 1;
  min-width: 0;
  resize: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  padding: 11px;
  font: inherit;
  max-height: 120px;
}

button {
  border: 0;
  background: #8256d9;
  color: white;
  border-radius: 14px;
  padding: 0 17px;
  font-weight: 700;
  cursor: pointer;
}

button:active {
  opacity: .7;
}

.status {
  text-align: center;
  color: #8f879c;
  font-size: 11px;
  margin-top: 8px;
}
</style>
</head>

<body>

<header>
  <img src="logo.svg" alt="Light AI">
</header>

<main id="chat">
  <div class="welcome" id="welcome">
    <img src="icon.svg" alt="Light AI app icon">
    <h1>What can I help with?</h1>
    <p>A simpler space to think, learn and create.</p>
  </div>
</main>

<div class="composer">
  <form id="form">
    <textarea id="input" rows="1"
      placeholder="Message Light AI..." required></textarea>
    <button type="submit">Send</button>
  </form>

  <div class="status" id="status">
    Light AI · AI connection coming soon
  </div>
</div>

<script>
const form = document.getElementById("form");
const input = document.getElementById("input");
const chat = document.getElementById("chat");
const welcome = document.getElementById("welcome");

function addMessage(text, type) {
  const message = document.createElement("div");
  message.className = "message " + type;
  message.textContent = text;
  chat.appendChild(message);
  chat.scrollTop = chat.scrollHeight;
}

form.addEventListener("submit", event => {
  event.preventDefault();

  const text = input.value.trim();
  if (!text) return;

  welcome?.remove();
  addMessage(text, "user");
  input.value = "";

  document.getElementById("status").textContent =
    "AI connection coming soon";
});

input.addEventListener("keydown", event => {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    form.requestSubmit();
  }
});
</script>

</body>
</html>
